# Smart Canteen — Environment Configuration Example
APP_NAME="Smart Canteen — Queue Optimization & Intelligent Capacity Planning"
APP_ENV="development"
DEBUG="true"
DATABASE_URL="sqlite:///./smart_canteen.db"
SECRET_KEY="replace-with-secure-random-hex-secret-key-in-local-env"
SESSION_COOKIE_NAME="sc_session"
CSRF_COOKIE_NAME="sc_csrf"
SESSION_EXPIRE_MINUTES=480
CANTEEN_TIMEZONE="Asia/Kolkata"
REQUIRE_REGISTRATION_NUMBER="true"
DEFAULT_RESERVATION_TIMEOUT_MINUTES=10
DEFAULT_SAFETY_FACTOR=0.85
DEFAULT_MERCHANT_NAME="Smart Canteen Campus"
DEFAULT_UPI_VPA="canteen@examplebank"
DEFAULT_MERCHANT_DESCRIPTION="College Smart Canteen Food Order"
DEFAULT_CURRENCY="INR"
DEFAULT_PAYMENT_MODE="DIRECT_UPI"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_TEST_MODE="true"
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000"
